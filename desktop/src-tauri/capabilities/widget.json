{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Desktop widget: core APIs plus dragging and hiding its own frameless window.",
  "windows": ["widget"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide"
  ]
}
