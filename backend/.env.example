# Copy to `backend/.env` to override defaults. Every variable is optional.
# All settings use the CORE_TRACK_ prefix (see app/config.py).

# SQLAlchemy URL of the SQLite database.
# Default: sqlite:///<repo>/backend/data/core_track.db
# CORE_TRACK_DATABASE_URL=sqlite:////Users/you/Documents/core-track/backend/data/core_track.db

# Browser origins allowed to call the API (JSON array).
# The defaults already cover the Tauri dev server and the packaged Tauri app.
# CORE_TRACK_CORS_ORIGINS=["http://localhost:1420","tauri://localhost","http://tauri.localhost"]

# Largest date range (in days) the /api/calendar endpoint will aggregate.
# CORE_TRACK_MAX_CALENDAR_SPAN_DAYS=366
